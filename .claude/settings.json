{
  "enabledMcpjsonServers": [
    "book-agent"
  ],
  "env": {
    "MCP_TOOL_TIMEOUT": "3600000",
    "MAX_MCP_OUTPUT_TOKENS": "60000"
  },
  "permissions": {
    "allow": [
      "mcp__book-agent"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/bookdev_session_hook.py\""
          }
        ]
      }
    ]
  }
}